# TuShare API Token (可选，用于获取市场数据)
TUSHARE_TOKEN=your_tushare_token_here
TUSHARE_API_TOKEN=your_tushare_token_here

# OpenBB MCP (可选，用于金融问答实时数据增强)
# 本机运行：http://127.0.0.1:8011/mcp
# Docker 容器内访问宿主机 OpenBB： http://host.docker.internal:8011/mcp
OPENBB_MCP_ENABLED=false
OPENBB_MCP_URL=http://127.0.0.1:8011/mcp
OPENBB_MCP_API_KEY=
OPENBB_MCP_PREFERRED_TOOLS=
OPENBB_MCP_MAX_TOOLS=3

# 基金池配置（可选）
# 本地增强基金池 JSON 路径：支持绝对路径或相对 DATA_DIR
# 例如：data/fund/southern-fund-a-universe.json
FUND_UNIVERSE_LOCAL_PATH=
# 基金公司筛选（逗号或换行分隔）；留空表示全市场
FUND_UNIVERSE_COMPANY_FILTER=

# 事件驱动 / 资产配置 / 基金诊断 提示词模板（可选）
# 支持占位符：
# EVENT_IMPACT_MARKET_VIEW_PROMPT_TEMPLATE: {{summary_json}}
# EVENT_IMPACT_FUND_PANEL_PROMPT_TEMPLATE: {{rows_json}}
# PORTFOLIO_CHECK_AGENT_PROMPT_TEMPLATE:
#   {{input_text}} {{risk_score}} {{top_holdings}} {{top_sectors}} {{top_factors}} {{tushare_brief}}
EVENT_IMPACT_MARKET_VIEW_PROMPT_TEMPLATE=
EVENT_IMPACT_FUND_PANEL_PROMPT_TEMPLATE=
PORTFOLIO_CHECK_AGENT_PROMPT_TEMPLATE=
PORTFOLIO_CHECK_AGENT_SYSTEM_PROMPT=

# 内置搜索（SearXNG）
# Docker 镜像内会启动一个 SearXNG（默认端口 8080），推荐在容器内使用 localhost。
SEARXNG_API_URL=http://localhost:8080
# Optional: multiple SearXNG endpoints (comma/newline separated), e.g.
# SEARXNG_API_URLS=https://searxng.example.com,https://search.example.net
SEARXNG_API_URLS=

# 大模型提供商（按需配置其一或多个）
# OpenAI / OpenAI-Compatible
OPENAI_API_KEY=
OPENAI_BASE_URL=

# MiniMax（OpenAI-compatible）
# API Key 从 config.json 中的 modelProviders 读取
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_DEFAULT_MODEL=MiniMax-M2.7
# 可选：MiniMax 向量模型（默认 embo-01）
MINIMAX_EMBEDDING_MODEL=embo-01
# 可选：MiniMax 图像生成模型
MINIMAX_IMAGE_MODEL=image-01

# 高阶深度研究（OpenAI-compatible / Gitee AI）
GITEE_AI_API_KEY=
GITEE_AI_BASE_URL=https://ai.gitee.com/v1
GITEE_AI_DEEP_RESEARCH_MODEL=DeepSeek-V4-Flash

# 附件与检索向量模型（SiliconFlow / OpenAI-compatible）
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-m3

# MiniMax MCP（可选，用于多模态功能）
# 文档参考：https://platform.minimaxi.com/docs/guides/mcp-guide
MINIMAX_MCP_ENABLED=true
# Docker 内置 MCP 时建议使用容器内地址（默认）
MINIMAX_MCP_URL=http://127.0.0.1:18190/rest
MINIMAX_MCP_API_KEY=
MINIMAX_MCP_PREFERRED_TOOLS=web_search,understand_image,text_to_image,text_to_audio,generate_video
MINIMAX_MCP_MAX_TOOLS=5
# 模式：media（推荐，支持多模态）| coding-plan
MINIMAX_MCP_MODE=media
# 置为 true 时，如果 MCP 启动失败则容器直接退出
MINIMAX_MCP_REQUIRED=false

# 可选：管理接口鉴权（用于 /api/config POST、/api/cache/invalidate POST）
# 配置后需要在请求头携带 x-admin-token 或 Authorization: Bearer <token>
ADMIN_ACCESS_TOKEN=

# 缓存观测告警阈值（可选）
# 命中率低于该值触发告警（1-99）
CACHE_HIT_RATE_WARN_PCT=55
# 平均重算耗时高于该值触发告警（毫秒）
CACHE_RECOMPUTE_AVG_WARN_MS=15000
# 峰值重算耗时高于该值触发告警（毫秒）
CACHE_RECOMPUTE_MAX_WARN_MS=30000

# Anthropic
ANTHROPIC_API_KEY=

# Groq
GROQ_API_KEY=

# Google
GOOGLE_API_KEY=

# 财经新闻数据源配置
# 默认所有主流数据源都已启用，可以通过设置为 false 来禁用

# 财联社 - 专业财经快讯
NEWS_SOURCE_CAILIANPRESS=true

# 华尔街见闻 - 国际财经资讯
NEWS_SOURCE_WALLSTREETCN=true

# 东方财富 - A股市场快讯
NEWS_SOURCE_EASTMONEY=true

# 雪球 - 投资社区资讯
NEWS_SOURCE_XUEQIU=true

# 第一财经 - 权威财经媒体
NEWS_SOURCE_YICAI=true

# 新浪财经 - 综合财经新闻
NEWS_SOURCE_SINA=true

# 同花顺 - A股资讯
NEWS_SOURCE_THS=true

# 金融界 - 证券资讯 (可选)
NEWS_SOURCE_JRJ=false

# 凤凰财经 - 财经评论 (可选)
NEWS_SOURCE_PHOENIX=false

# ============================================
# 数据缓存目录 (可选)
# ============================================
# DATA_DIR=/path/to/data