# TuShare API Token (可选，用于获取市场数据)
TUSHARE_TOKEN=your_tushare_token_here
TUSHARE_API_TOKEN=your_tushare_token_here

# 内置搜索（SearXNG）
# Docker 镜像内会启动一个 SearXNG（默认端口 8080），推荐在容器内使用 localhost。
SEARXNG_API_URL=http://localhost:8080

# 大模型提供商（按需配置其一或多个）
# OpenAI / OpenAI-Compatible
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Anthropic
ANTHROPIC_API_KEY=

# Groq
GROQ_API_KEY=

# Google
GOOGLE_API_KEY=

# 财经新闻数据源配置
# 默认所有主流数据源都已启用，可以通过设置为 false 来禁用

# 财联社 - 专业财经快讯
NEWS_SOURCE_CAILIANPRESS=true

# 华尔街见闻 - 国际财经资讯
NEWS_SOURCE_WALLSTREETCN=true

# 东方财富 - A股市场快讯
NEWS_SOURCE_EASTMONEY=true

# 雪球 - 投资社区资讯
NEWS_SOURCE_XUEQIU=true

# 第一财经 - 权威财经媒体
NEWS_SOURCE_YICAI=true

# 新浪财经 - 综合财经新闻
NEWS_SOURCE_SINA=true

# 同花顺 - A股资讯
NEWS_SOURCE_THS=true

# 金融界 - 证券资讯 (可选)
NEWS_SOURCE_JRJ=false

# 凤凰财经 - 财经评论 (可选)
NEWS_SOURCE_PHOENIX=false

# 数据缓存目录 (可选)
# DATA_DIR=/path/to/data
